<!--
  Colorful Profiles — front-end layout (with user menu), overriding Base layouts/web.ejs.
  Renders the site header with the logged-in user's avatar and dropdown menu (edit profile,
  plugin menu items, admin, logout), plugin stylesheets, and the shell/footer around the body.

  @since 1.0.0
-->

<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= siteConfig.siteName || siteConfig.title || 'LinearPress' %></title><meta name="description" content="<%= siteConfig.siteDescription || siteConfig.description %>"><% if (siteConfig.customCss) { %><style><%- siteConfig.customCss %></style><% } %><link rel="stylesheet" href="/css/style.css"><% for (const css of pluginStyleUrls) { %><link rel="stylesheet" href="<%= css %>"><% } %></head><body><header class="site-header"><a class="brand" href="/"><%= siteConfig.siteName || 'LINEARPRESS' %></a><nav><a href="/">首页</a><% if (currentUser) { %><div class="cf-user-menu"><button type="button" class="cf-menu-trigger" aria-haspopup="true" aria-expanded="false"><%- cfAvatarHtml(currentUser.id, 32, 'cf-menu-avatar') %><span class="cf-menu-name"><%= cfDisplayName(currentUser.id) %></span></button><div class="cf-dropdown" role="menu"><div class="cf-dropdown-identity"><%- cfAvatarHtml(currentUser.id, 56, 'cf-dropdown-avatar') %><div class="cf-dr-id"><div class="cf-dr-name"><%= cfDisplayName(currentUser.id) %></div><div class="cf-dr-username">@<%= currentUser.username %></div><div class="cf-dr-email"><%= currentUser.email || '' %></div></div></div><a role="menuitem" href="/profile/edit" class="cf-edit-profile">编辑个人资料</a><% (cpUserMenuItems || []).forEach((item) => { %><a role="menuitem" href="<%= item.link %>"><%= item.title %></a><% }) %><a role="menuitem" href="/admin">后台</a><form action="/logout" method="post" role="menuitem"><button type="submit" class="cf-dropdown-logout">退出登录</button></form></div></div><% } else { %><a href="/login">登录</a><% } %></nav></header><main class="shell"><%- body %></main><footer class="site-footer"><% if (siteConfig.footerCopyright !== 'none') { %><p class="footer-copy"><%= siteConfig.footerCopyright === 'running-on' ? ('本站正在运行基于 CordisJS 的 LinearPress 版本 ' + LINEARPRESS_VERSION + '。') : ('由 LinearPress 强力驱动，基于 CordisJS。正在运行的版本为：' + LINEARPRESS_VERSION + '。') %></p><% } %><% if (siteConfig.icpNumber) { %><p class="footer-icp"><%= siteConfig.icpProvince ? siteConfig.icpProvince : '' %>ICP备<%= siteConfig.icpNumber %>号<% if (siteConfig.policeNumber) { %> | 国公网安备第<%= siteConfig.policeNumber %>号<% } %></p><% } %><% if (siteConfig.footerHtml) { %><div class="footer-html"><%- siteConfig.footerHtml %></div><% } %><p class="footer-meta">TYPE-SAFE PUBLISHING / <%= new Date().getFullYear() %></p></footer><% for (const script of pluginScriptUrls) { %><script src="<%= script %>"></script><% } %></body></html>