<!--
  Author: MoyuZJ
  Team: LinearTeam
  Contact: linearteam@foxmail.com
  Made by MoyuZJ in China with ♥
  Colorful Profiles —— 覆盖文章阅读页：作者头像、评论者头像与资料链接；
  保留高级评论（advanced-comments）的 Markdown 评论、IP 归属地、限频表单与表情面板。
-->

<article class="article"><p class="meta"><%= formatDate(post.created_at) %> / <%= post.views %> VIEWS</p><h1><%= post.title %></h1>
<% var cpAuthor = colorfulUsers && colorfulUsers[post.author_id]; %><div class="cf-post-author"><%- cfAvatarHtml(post.author_id, 46, 'cf-author-avatar') %><div class="cf-author-meta"><% if (currentUser && cpAuthor && cfProfileHref(post.author_id)) { %><a href="<%= cfProfileHref(post.author_id) %>" class="cf-author-name"><%= cfDisplayName(post.author_id) %></a><% } else { %><span class="cf-author-name"><%= cfDisplayName(post.author_id) %></span><% } %><span class="cf-author-sub"><%= formatDate(post.created_at) %> · <%= post.views %> VIEWS</span></div></div>
<div class="article-body"><%- html %></div></article>
<section class="comments ac-comments">
  <h2>评论</h2>
  <% if (acCommentError) { %><p class="ac-error"><%= acCommentError %></p><% } %>
  <% if (notice) { %><p class="notice">评论已提交，等待审核。</p><% } %>
  <% comments.forEach(comment => { %>
    <% var meta = (ac && ac.meta && ac.meta[comment.id]) || null; %>
    <% var cu = colorfulUsers && comment.user_id ? colorfulUsers[comment.user_id] : null; %>
    <div class="comment ac-comment">
      <div class="ac-comment-head">
        <% if (comment.user_id) { %><%- cfAvatarHtml(comment.user_id, 38, 'cf-comment-avatar') %><% } else { %><span class="cf-comment-avatar cf-comment-avatar-guest">👤</span><% } %>
        <div class="ac-comment-author">
          <strong><% if (comment.user_id && currentUser && cu && cfProfileHref(comment.user_id)) { %><a href="<%= cfProfileHref(comment.user_id) %>" class="cf-comment-author"><%= cfDisplayName(comment.user_id) %></a><% } else { %><%= comment.guest_name || (cu ? cfDisplayName(comment.user_id) : '注册用户') %><% } %></strong>
          <% if (comment.user_id == null && meta) { %><span class="ac-ip">IP <%= meta.ip %> · <%= meta.location %></span><% } %>
        </div>
      </div>
      <div class="ac-comment-body"><%- (ac && ac.renderComment) ? ac.renderComment(comment.content) : comment.content %></div>
    </div>
  <% }) %>

  <form method="post" action="<%= postUrl(post) %>/comments" class="ac-comment-form">
    <% if (currentUser) { %>
      <p class="ac-as">以 <strong><%= cfDisplayName(currentUser.id) %></strong> 身份评论。</p>
    <% } else { %>
      <input name="guest_name" placeholder="姓名（必填）" class="ac-name" required>
      <input name="guest_email" type="email" placeholder="邮箱（选填）" class="ac-email">
    <% } %>
    <div class="ac-editor">
      <textarea name="content" id="ac-comment-content" required placeholder="写下你的评论，支持 Markdown 语法…" class="ac-textarea"></textarea>
      <div class="ac-toolbar">
        <button type="button" class="ac-emoji-btn" id="ac-emoji-btn" title="表情"><span>☺</span> 表情</button>
        <span class="ac-toolbar-right"><span class="ac-md-hint">M↓ Supported</span><span class="ac-char-count" id="ac-char-count">0/<%= ac ? ac.config.maxLength : 300 %></span></span>
      </div>
    </div>
    <button class="button" type="submit">提交评论</button>
  </form>
</section>

<script>window.__AC_EMOJI_API__ = "<%= ac ? ac.api : '' %>";window.__AC_MAXLEN__ = <%= ac ? ac.config.maxLength : 300 %>;window.__AC_EMOJI_ENABLED__ = <%= ac && ac.emojiEnabled ? 'true' : 'false' %>;</script>