{
  "id": "colorful-profiles",
  "name": "个人资料",
  "version": "4.0.0",
  "description": "昵称、头像（支持 GIF/APNG 动图，可选取正方形区域）和公开的个人主页；头像和昵称会显示在文章、评论和导航栏里。",
  "author": "LinearPress",
  "icon": "资料",
  "type": "both",
  "cssPrefix": "cp",
  "main": "index.ts",
  "views": "views",
  "public": "public",
  "settings": "/admin/profiles",
  "styles": [
    { "file": "colorful-profiles.css", "scope": "all" }
  ],
  "scripts": [
    { "file": "colorful-profiles.js", "scope": "web", "paths": ["/account/profile"] }
  ],
  "permissions": [
    { "id": "colorful-profiles:manage", "label": "管理个人资料设置", "group": "用户" }
  ]
}
